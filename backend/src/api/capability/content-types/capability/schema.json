{
  "kind": "collectionType",
  "collectionName": "capabilities",
  "info": {
    "singularName": "capability",
    "pluralName": "capabilities",
    "displayName": "Capability",
    "description": "Portfolio capability categories"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "portfolios": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::portfolio.portfolio",
      "mappedBy": "capabilities"
    }
  }
}
